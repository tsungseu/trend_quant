# apps/web 环境变量示例（复制为 .env / .env.local 后按需修改）

# 「进入终端」按钮指向的终端地址。
# 本地开发：终端跑在 5173 端口，history 路由，入口为 /app
#   VITE_TERMINAL_URL=http://localhost:5173/app
# GitHub Pages：终端与官网同域部署在 /trend_quant/ 子路径，终端生产用 hash 路由，
#   入口为 /trend_quant/#/app
#   VITE_TERMINAL_URL=https://tsungseu.github.io/trend_quant/#/app
# 若官网与终端同源，也可用相对 hash：/trend_quant/#/app
VITE_TERMINAL_URL=http://localhost:5173/app

# 站点部署 base 路径。GitHub Pages 子路径部署时用于覆盖默认 /trend_quant/。
# VITE_PUBLIC_BASE=/trend_quant/
