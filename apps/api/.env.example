# apps/api 环境变量示例（复制为 .env 后按需修改）
#
# 本地开发无 CLERK_SECRET_KEY 时，鉴权 hook 自动进入 fake 模式（userId=dev-local-user），
# 便于不接 Clerk 也能跑通骨架。生产部署必须提供真实密钥。

# --- 服务 ---
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
# 允许的前端来源，逗号分隔（CORS）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Clerk 鉴权（PR2 接入真校验）---
# 前端 publishable key 与后端 secret key，来自 Clerk Dashboard
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Qdrant（向量库）---
# 本地：docker-compose 起的 http://localhost:6333（无需 API key）
# 云端：Qdrant Cloud 集群 URL + API key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- OpenAI（embedding + chat，仅后端调用）---
OPENAI_API_KEY=

# --- 对象存储（原始上传文件）---
# 本地用 MinIO（docker-compose 起）；线上用 S3 / Cloudflare R2
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=trendquant-kb
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
