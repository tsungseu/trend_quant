# ============================================================
# 趋势量化 / TrendQuant 环境变量示例
# 复制为 .env（或 .env.local）后按需修改
# ============================================================

# 运行数据模式：
#   demo   = 仅历史快照/示例数据，不请求任何第三方接口（GitHub Pages 默认）
#   direct = 浏览器直连东方财富/腾讯/新浪（仅适合本地开发或自用研究）
#   proxy  = 通过 VITE_DATA_PROXY_BASE 指向的代理/边缘网关获取真实数据（线上推荐）
VITE_DATA_MODE=demo

# 代理基址：仅 proxy 模式生效。例：https://your-worker.example.com
# 网关需实现以下接口（GET，返回 JSON）：
#   /fund/search?keyword=        -> 基金搜索列表
#   /fund/nav?code=&days=        -> 基金净值序列
#   /fund/estimate?code=         -> 基金实时估值
#   /fund/profile?code=          -> 基金档案
#   /fund/holdings?code=         -> 基金重仓股
#   /market/kline?secid=&days=   -> 股票/指数K线
#   /market/intraday?secid=      -> 股票分时
#   /market/quotes?codes=        -> 批量行情快照
VITE_DATA_PROXY_BASE=

# 是否允许浏览器直接执行第三方 JSONP/script（直连模式必填 true）
# 注意：JSONP/script-tag 等同于执行第三方脚本，仅建议本地或自用研究环境开启
VITE_ALLOW_THIRD_PARTY_SCRIPTS=false

# 是否启用"模拟行情跳动"动画（随机扰动 mock 价格）
# 默认 false：生产环境禁用，避免模拟价格与真实数据混用
VITE_ENABLE_MOCK_LIVE=false

# Vite publicBase：生产部署子路径
# GitHub Pages 项目页 https://<user>.github.io/trend_quant/ 用 /trend_quant/
# 顶层域名根路径部署留空字符串或填 /
VITE_PUBLIC_BASE=/trend_quant/
