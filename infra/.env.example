# infra 环境变量示例：本地开发用 docker-compose 起的默认值即可，
# 生产/云端部署复制为 .env 并替换为真实凭据。

# === Qdrant ===
# 本地（docker-compose）：无 API key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# === MinIO / S3 ===
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=trendquant-kb
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# === OpenAI（embedding + chat）===
OPENAI_API_KEY=

# === Clerk（鉴权）===
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# === 后端服务 ===
PORT=8080
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# === 前端指向后端 ===
# apps/terminal / apps/web 用：VITE_RAG_API_URL=http://localhost:8080
